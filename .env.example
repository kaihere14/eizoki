# Copy to .env.local, or use `clerk env pull` after linking your Clerk application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
# Public PostHog browser analytics configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
DATABASE_URL="postgresql://user:password@host:5432/eizoki?schema=public"
# Server-only key for sponsor icons and deleting pre-R2 videos. Never prefix with NEXT_PUBLIC_.
IMAGEKIT_PRIVATE_KEY=
# Cloudflare R2 stores uploaded videos. Browsers upload parts directly using
# presigned URLs, so the bucket needs a CORS policy (see README). Server-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for playback: the bucket's custom domain or r2.dev URL, no trailing slash.
R2_PUBLIC_URL=video.eizoki.xyz
