// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Which default illustration represents the user. The app ships both
/// avatars, so only the choice is stored — never an image URL.
enum Avatar {
  GIRL
  BOY

  @@map("avatar")
}

/// Mirrors a Clerk user. `clerkId` is the Clerk `user_...` id and is the
/// stable identity we upsert against; `id` is our own internal primary key.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  username  String?
  avatar    Avatar   @default(BOY)
  /// Managed by trusted server/database operations, never self-service profile updates.
  isAdmin   Boolean  @default(false)
  /// Set by hand to stop new uploads (videos and sponsor videos). Browsing,
  /// favourites and the rest of the account keep working.
  uploadBanned Boolean @default(false)
  /// Set by hand to suspend the account: every protected API refuses it and
  /// the app signs the user out as soon as it loads their record.
  banned       Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submittedVideos Video[]     @relation("VideoSubmitter")
  reviewedVideos  Video[]     @relation("VideoReviewer")
  favourites      Favourite[]

  bookedSponsorships   Sponsorship[] @relation("SponsorshipBooker")
  reviewedSponsorships Sponsorship[] @relation("SponsorshipReviewer")

  @@map("users")
}

enum VideoReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("video_review_status")
}

enum VideoPromptStatus {
  ORIGINAL
  RECONSTRUCTED
  UNAVAILABLE

  @@map("video_prompt_status")
}

/// One catalog entry for both admin-curated and community-submitted videos.
/// Created only after the stored video is confirmed. Public reads require APPROVED
/// and a publishedAt no later than the current time.
model Video {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  /// Stable category slug; categories can grow without a database enum migration.
  category    String
  tags        String[] @default([])
  isFeatured  Boolean  @default(false)

  submittedById String
  submittedBy   User   @relation("VideoSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  /// Attribution is independent of the submitter and does not require an account.
  creatorName       String
  creatorUsername   String?
  creatorXUrl       String?
  creatorProfileUrl String?
  sourceUrl         String?

  /// Store the original asset. Derive preview transformations at delivery time.
  /// Null only for a REJECTED video: its file is deleted on rejection.
  videoUrl        String?
  /// While the file exists, exactly one of these names it: older uploads live
  /// on ImageKit, new ones in R2. A rejected video has neither (both rules are
  /// enforced by a database check constraint).
  imagekitFileId  String? @unique
  storageKey      String? @unique
  durationSeconds Float?

  /// Keep the prompt verbatim; append our stable video reference URL on copy.
  promptStatus   VideoPromptStatus @default(UNAVAILABLE)
  promptText     String?
  negativePrompt String?
  toolsUsed      String[]          @default([])
  curatorNotes   String?

  /// The submission service will approve admin submissions using User.isAdmin.
  /// A safe database default keeps ordinary submissions out of the public feed.
  reviewStatus VideoReviewStatus @default(PENDING_REVIEW)
  reviewedById String?
  reviewedBy   User?             @relation("VideoReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNotes  String?
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  favourites Favourite[]

  @@index([reviewStatus, createdAt, id])
  @@index([reviewStatus, publishedAt, id])
  @@index([submittedById, createdAt, id])
  @@index([reviewedById])
  @@index([category, publishedAt, id])
  @@index([tags], type: Gin)
  @@map("videos")
}

/// A private bookmark from one user to one video. The unique pair means a video
/// can be saved at most once per user, and the user-scoped index keeps each
/// shelf keyset-paginated by when it was saved.
model Favourite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([userId, createdAt, id])
  @@index([videoId])
  @@map("favourites")
}

enum SponsorshipPlacement {
  NAVBAR
  FEED_VIDEO

  @@map("sponsorship_placement")
}

/// Lifecycle only. Whether an APPROVED booking is live, scheduled or ended is
/// derived from startsAt/endsAt at read time, so the status never goes stale.
enum SponsorshipStatus {
  /// Reserved for checkout; bookings skip it until payments exist.
  PENDING_PAYMENT
  PENDING_REVIEW
  APPROVED
  REJECTED
  CANCELLED

  @@map("sponsorship_status")
}

/// One paid placement: a navbar icon or a sponsored video pinned in the feed.
/// Public reads require APPROVED and startsAt <= now < endsAt.
model Sponsorship {
  id        String               @id @default(cuid())
  placement SponsorshipPlacement
  status    SponsorshipStatus    @default(PENDING_REVIEW)

  /// Null only for sponsors arranged directly, before self-serve booking.
  bookedById   String?
  bookedBy     User?   @relation("SponsorshipBooker", fields: [bookedById], references: [id], onDelete: SetNull)
  /// Required for every self-serve booking; may be absent for direct deals.
  contactEmail String?

  productName String
  /// Stored without tracking parameters; UTM is appended when rendering.
  websiteUrl  String
  description String?

  /// Custom brand icon. Without one the website favicon is used.
  iconUrl            String?
  iconImagekitFileId String? @unique

  /// FEED_VIDEO only. Kept separate from Video so paid placements never enter
  /// the editorial catalogue, favourites or search.
  videoUrl            String?
  videoImagekitFileId String? @unique
  /// R2 object key for videos uploaded after the move off ImageKit.
  videoStorageKey     String? @unique
  durationSeconds     Float?

  /// Every booking is one calendar month. The dates are set on approval.
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)

  reviewedById String?
  reviewedBy   User?     @relation("SponsorshipReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([placement, status, startsAt, endsAt])
  @@index([status, createdAt])
  @@index([bookedById, createdAt])
  @@index([reviewedById])
  @@map("sponsorships")
}
